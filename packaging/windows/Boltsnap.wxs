<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="Boltsnap"
      Manufacturer="Boltsnap contributors"
      Version="$(var.ProductVersion)"
      UpgradeCode="A6F06FE6-41E0-4B57-A22E-3F3EC54B1D3E"
      Language="1033"
      Scope="perUser"
      InstallerVersion="500">
    <SummaryInformation Description="Fast native screenshot and screen-recording tool for Windows" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Boltsnap is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <util:CloseApplication Id="CloseBoltsnap" Target="boltsnap.exe"
                           CloseMessage="yes" Timeout="2" TerminateProcess="0"
                           RebootPrompt="no" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsDirectory" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Boltsnap">
          <Directory Id="EDDYFOLDER" Name="Eddy" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="BoltsnapProgramMenuFolder" Name="Boltsnap" />
    </StandardDirectory>

    <Feature Id="BoltsnapFeature" Title="Boltsnap" Level="1" Display="hidden"
             Description="Screenshot, Bildschirmaufnahme, Shelf, Tray und globale Windows-Hotkeys.">
      <ComponentRef Id="BoltsnapExecutable" />
      <ComponentRef Id="BoltsnapUserIntegration" />
      <ComponentRef Id="BoltsnapStartMenuShortcut" />
    </Feature>

    <Feature Id="EddyFeature" Title="Eddy Bildeditor (empfohlen)" Level="1"
             Description="Eddy ist der schnelle Bildeditor für Markierungen, Pfeile, Text, Unschärfe und Schwärzungen. Rechtsklick auf ein Shelf-Bild öffnet es direkt in Eddy.">
      <Files Include="$(var.EddySourceDir)\**" Directory="EDDYFOLDER" />
      <ComponentRef Id="EddyUserIntegration" />
      <ComponentRef Id="EddyStartMenuShortcut" />
    </Feature>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="BoltsnapExecutable" Guid="E447B241-1B17-46DB-8D8A-66F3FF892B8E">
        <File Id="BoltsnapExecutableFile" Source="$(var.BoltsnapSourceDir)\boltsnap.exe"
              Name="boltsnap.exe" KeyPath="yes" />
        <File Id="BoltsnapBackgroundFile" Source="$(var.BoltsnapSourceDir)\boltsnap-background.exe"
              Name="boltsnap-background.exe" />
      </Component>
      <Component Id="BoltsnapUserIntegration" Guid="09F6E844-2B82-47A2-B2C8-D308A4D54157">
        <RegistryValue Root="HKCU" Key="Software\Boltsnap" Name="InstallLocation"
                       Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Control Panel\Keyboard"
                       Name="PrintScreenKeyForSnippingEnabled" Value="0" Type="integer" />
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\boltsnap.exe"
                       Value="[INSTALLFOLDER]boltsnap.exe" Type="string" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="EDDYFOLDER">
      <Component Id="EddyUserIntegration" Guid="ACFF5B58-C4EF-4A4C-991B-F934CE17B5C6">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\eddy.exe"
                       Value="[EDDYFOLDER]eddy.exe" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\eddy.exe"
                       Name="Path" Value="[EDDYFOLDER]" Type="string" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="BoltsnapProgramMenuFolder">
      <Component Id="BoltsnapStartMenuShortcut" Guid="C0C1BE6B-020D-4F63-B2B8-C21A271B0CC2">
        <Shortcut Id="BoltsnapStartMenu" Name="Boltsnap" Description="Boltsnap Screenshot Tool"
                  Target="[INSTALLFOLDER]boltsnap-background.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveBoltsnapProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Boltsnap" Name="StartMenuShortcut"
                       Value="1" Type="integer" KeyPath="yes" />
      </Component>
      <Component Id="EddyStartMenuShortcut" Guid="A0234F6F-AC49-4D93-98D0-F5DDFE48FBE1">
        <Shortcut Id="EddyStartMenu" Name="Eddy" Description="Eddy Bildeditor"
                  Target="[EDDYFOLDER]eddy.exe" WorkingDirectory="EDDYFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Boltsnap" Name="EddyStartMenuShortcut"
                       Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <CustomAction Id="InstallBoltsnapAutostart" FileRef="BoltsnapExecutableFile"
                  ExeCommand="__install-autostart" Execute="immediate"
                  Impersonate="yes" Return="check" />
    <CustomAction Id="RemoveBoltsnapAutostart" FileRef="BoltsnapExecutableFile"
                  ExeCommand="__remove-autostart" Execute="immediate"
                  Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveBoltsnapAutostart" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="InstallBoltsnapAutostart" After="InstallFinalize"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
