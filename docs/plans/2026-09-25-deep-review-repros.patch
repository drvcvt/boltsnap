+#[cfg(test)]
+mod deep_review_repros {
+    use std::process::Command;
+    use std::time::{Duration, Instant};
+
+    #[test]
+    fn deep_review_probe_deadline_includes_inherited_output_pipes() {
+        // The shell exits promptly; its finite child keeps stdout/stderr open.
+        // No existing process is signalled and no file is deleted.
+        let started = Instant::now();
+        let result = super::output(
+            Command::new("sh").args(["-c", "sleep 1.2 & exit 0"]),
+            Duration::from_millis(40),
+        );
+        let elapsed = started.elapsed();
+        eprintln!(
+            "deadline=40ms elapsed={elapsed:?} result_ok={}",
+            result.is_ok()
+        );
+        assert!(
+            elapsed < Duration::from_millis(300),
+            "pipe reads outlive deadline: {elapsed:?}"
+        );
+    }
+}
